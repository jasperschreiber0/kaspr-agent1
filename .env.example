# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+61400000000
# Used by smsSender.js for review-request / missed-call SMS (not the
# WhatsApp channel). Not currently in REQUIRED_ENV, so the app will boot
# without it — but every SMS send will fail with "not_configured" until
# it's set.
TWILIO_SMS_NUMBER=+61400000001

# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (Whisper for voice transcription)
OPENAI_API_KEY=sk-...

# Anthropic (Instagram DM/comment reply generation)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for kaspr-site's two tiers — must match what /api/checkout
# on kaspr-site creates Checkout Sessions with, or payments will be
# misattributed to the "grow" fallback tier in the onboarding email.
STRIPE_PRICE_GROW=price_...
STRIPE_PRICE_FULL_STACK=price_...

# Resend (transactional email)
RESEND_API_KEY=re_...

# Meta / Instagram Graph API
META_VERIFY_TOKEN=any_string_you_choose
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://your-agent1-domain/auth/instagram/callback

# Discord webhooks
DISCORD_WEBHOOK_KASPR_LOGS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_KASPR_ERRORS=https://discord.com/api/webhooks/...

# Railway injects PORT automatically
PORT=3001
