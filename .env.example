# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+61400000000

# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (Whisper for voice transcription)
OPENAI_API_KEY=sk-...

# Anthropic (Claude for IG comment/DM replies)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_REVIVE=price_...
STRIPE_PRICE_REVIVE_GROW=price_...
STRIPE_PRICE_FULL_STACK=price_...

# Resend (onboarding emails)
RESEND_API_KEY=re_...

# Meta / Instagram
META_VERIFY_TOKEN=your_webhook_verify_token
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://yourdomain.com/auth/instagram/callback

# Discord webhooks
DISCORD_WEBHOOK_KASPR_LOGS=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_KASPR_ERRORS=https://discord.com/api/webhooks/...

# Railway injects PORT automatically
PORT=3001
